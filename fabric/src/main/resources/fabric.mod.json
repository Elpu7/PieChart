{
  "schemaVersion": 1,
  "id": "piechart",
  "version": "${version}",
  "name": "PieChart",
  "description": "Toggle and edit the Pie Chart.",
  "authors": ["Elpu7"],
  "contact": {
    "homepage": "https://modrinth.com/project/piechart",
    "issues": "https://github.com/Elpu7/PieChart/issues",
    "sources": "https://github.com/Elpu7/PieChart"
  },
  "license": "MIT",
  "icon": "assets/piechart/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.elpu7.piechart.fabric.PiechartFabricClient"
    ],
    "modmenu": [
      "dev.elpu7.piechart.fabric.compat.PiechartModMenu"
    ]
  },
  "mixins": [
    {
      "config": "piechart.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": "${loader_dependency}",
    "fabric-api": "*",
    "minecraft": "${minecraft_dependency}",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*"
  }
}
